# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-here

# Model names. Check https://ai.google.dev/gemini-api/docs/models for current names.
GEN_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION=schemes

# Retrieval
TOP_K=8
RRF_K=60
MAX_REWRITES=2

# Agent mode: hard ceiling on tool calls per question.
# Not decoration — an unbounded agent loop with a paid model behind it is a bill.
MAX_STEPS=5

# Set OFFLINE=1 to run the whole graph with a deterministic stub LLM.
# No network, no API key, no cost. Used by the test suite.
OFFLINE=0

TRACE_PATH=traces/trace.jsonl
